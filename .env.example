# =============================================================================
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase  --  https://supabase.com/dashboard  >  Project Settings > API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only, bypasses RLS. Used by webhook handlers that have no user session.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
# Public origin used to build OAuth redirect URIs. No trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Token encryption (AES-256-GCM) for stored provider tokens.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# -----------------------------------------------------------------------------
TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key

# -----------------------------------------------------------------------------
# Strava  --  https://www.strava.com/settings/api
# Set "Authorization Callback Domain" to `localhost` for dev.
# -----------------------------------------------------------------------------
STRAVA_CLIENT_ID=123456
STRAVA_CLIENT_SECRET=your-strava-client-secret
# Any random string you invent; Strava echoes it back when subscribing to webhooks.
STRAVA_WEBHOOK_VERIFY_TOKEN=pick-any-random-string

# -----------------------------------------------------------------------------
# Google Gemini  --  https://aistudio.google.com/apikey  (free tier)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
# Google retires model names periodically; the app retries once with whatever
# replacement the 404 names. Flash models reason before answering, which costs
# ~500 hidden tokens per call.
GEMINI_MODEL=gemini-3.6-flash

# -----------------------------------------------------------------------------
# Telegram  --  message @BotFather on Telegram, /newbot
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:AA...
# Any random string; sent by Telegram as X-Telegram-Bot-Api-Secret-Token.
TELEGRAM_WEBHOOK_SECRET=pick-any-random-string
# Optional, only used to show "@yourbot" in the UI.
TELEGRAM_BOT_USERNAME=my_coach_bot

# -----------------------------------------------------------------------------
# Daily cron (Vercel sends this as `Authorization: Bearer <value>`)
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
# -----------------------------------------------------------------------------
CRON_SECRET=at-least-16-characters
